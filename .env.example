# Токен бота от @BotFather
BOT_TOKEN=

# Время ежедневного автопоста ЧЧ:ММ (по TIMEZONE)
DAILY_POST_TIME=09:00

# Часовой пояс для расписания
TIMEZONE=Europe/Moscow

# --- Веб + БД ---

# Пароль PostgreSQL (используется в docker-compose)
DB_PASSWORD=

# Локальная разработка: docker compose up -d db, затем этот URL
# На сервере compose подставляет DATABASE_URL внутрь контейнера сам — эту строку не трогаем
DATABASE_URL=postgresql://rui:PASSWORD@127.0.0.1:5434/rui

# Публичный URL дашборда (для кнопок входа из бота и Secure-cookie)
APP_URL=https://your-domain.example

# Порт приложения на хосте (Nginx/Hestia проксирует сюда)
APP_PORT=3005

# Как часто сохранять снимки RUI в БД (минуты)
SNAPSHOT_INTERVAL_MIN=60

# Срок жизни сессии дашборда (дни)
SESSION_TTL_DAYS=30

# Админы раздела «Администрирование» (username Telegram без @, через запятую)
ADMIN_USERNAMES=

# --- Деплой (deploy.sh / install-nginx-templates.sh, в git не попадает) ---
# user@host сервера; DEPLOY_DIR — путь на сервере (по умолчанию ~/rui)
DEPLOY_SERVER=
# DEPLOY_DIR=

# --- ИИ-аналитика на дашборде (z.ai, Anthropic-совместимый Messages API) ---
# API Key с https://z.ai/model-api. Без ключа блок ИИ отключён (503), остальное работает.
GLM_API_KEY=
# GLM_MODEL=glm-5.3
# GLM_BASE_URL=https://api.z.ai/api/anthropic
